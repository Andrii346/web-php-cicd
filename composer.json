{
  "name": "student/ci-cd-lab",
  "description": "Minimal PHP project for CI/CD testing",
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "laravel/pint": "^1.13"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "fakerphp/faker": "^1.24"
  }
}
